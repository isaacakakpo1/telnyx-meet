{
  "name": "telnyx-meet",
  "version": "1.0.0",
  "private": false,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:pwa": "NODE_ENV=production nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:component": "vitest run tests/component --passWithNoTests",
    "test:server": "vitest run tests/server --passWithNoTests",
    "test:smoke": "playwright test",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "dependencies": {
    "@bugsnag/js": "^7.10.1",
    "@fortawesome/fontawesome-svg-core": "^1.3.0",
    "@fortawesome/free-solid-svg-icons": "^6.0.0",
    "@telnyx/rtc-diagnostics": "^0.0.0-alpha.1",
    "@telnyx/video": "1.0.1",
    "@telnyx/video-processors": "^0.0.0-alpha.4",
    "bowser": "^2.11.0",
    "generate-unique-id": "^2.0.1",
    "libphonenumber-js": "^1.9.50",
    "memory-cache": "^0.2.0",
    "nuxt": "^3.21.11",
    "polished": "^4.1.0",
    "unique-names-generator": "^4.3.1",
    "uuid": "^8.3.2",
    "vue": "^3.5.46",
    "vue-router": "^4.6.4",
    "webrtc-adapter": "^7.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nuxt/test-utils": "^3.23.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
