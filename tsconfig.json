{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "downlevelIteration": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": [
    ".nuxt/nuxt.d.ts",
    ".nuxt/types/**/*.d.ts",
    "app.vue",
    "components/**/*.vue",
    "pages/**/*.vue",
    "layouts/**/*.vue",
    "composables/**/*.ts",
    "plugins/**/*.ts",
    "middleware/**/*.ts",
    "server/**/*.ts",
    "stores/**/*.ts",
    "types/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "benchmark",
    "next-env.d.ts",
    "contexts",
    "hooks",
    "lib",
    "utils",
    "**/pages/**/*.tsx",
    "**/pages/**/*.ts",
    "**/components/**/*.tsx",
    "**/components/**/*.ts"
  ]
}
