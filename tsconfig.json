{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "downlevelIteration": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": [
    ".nuxt/tsconfig.json",
    "app.vue",
    "nuxt.config.ts",
    "vitest.config.ts",
    "**/*.ts",
    "**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "benchmark",
    "next-env.d.ts",
    "**/pages/**/*.tsx",
    "**/pages/**/*.ts",
    "**/components/**/*.tsx",
    "**/components/**/*.ts"
  ]
}
